<?xml version="1.0" encoding="utf-8"?>
<!-- Kara: the enabled primary button, the one gold element of each screen. The
     Écrin filled gold is a three-stop gradient: the two ends come from colors.xml
     (the names the SDK already declares), the lighter band in the middle is set here
     because the SDK has no name for it. Same stops, direction and centre as
     KaraIdenfyLayout.applyBrandGradient on iOS: top-left to bottom-right, the light
     band at 60 %.

     The radius is the one piece of geometry the SDK exposes as a resource: iDenfy's
     29 dimens hold no corner radii, and the rest of its rounding is hardcoded in
     shape drawables like this one. 21dp is half the 42dp button height the layouts
     pin, so it is a full pill, matching `rounded-full` on our own Button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:centerColor="#EFD9A8"
        android:centerX="0.6"
        android:endColor="@color/idenfyGradientButtonColorEnd"
        android:startColor="@color/idenfyGradientButtonColorStart"
        android:type="linear" />

    <corners android:radius="21dp" />

</shape>
