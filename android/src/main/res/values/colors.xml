	<!-- ==================== Full-screen picker lists ==================== -->
	<!-- Language, document country, document type. Each list is an Écrin block: one
	     surface, rows left on the background token (KaraIdenfyLayout clears those, so
	     the block shows through), the selected row lifted, never gold: picking a row
	     only returns to the previous screen. The SDK fakes each border with a solid
	     layer behind the row, so the "border" colours go transparent rather than to a
	     hairline: the Écrin draws none. -->

	<color name="idenfyLanguageSelectionViewLanguageRecyclerViewBackgroundColor">#0FF5EFE6</color>
	<color name="idenfyLanguageSelectionViewLanguageRecyclerViewItemBackgroundColor">#0F0C11</color>
	<color name="idenfyLanguageSelectionViewLanguageRecyclerViewItemHighlightedBackgroundColor">#26F5EFE6</color>
	<color name="idenfyLanguageSelectionViewLanguageRecyclerViewItemHighlightedTextColor">#F5EFE6</color>
