	<color name="idenfyNoBackButtonAppBarBackgroundColor">#0F0C11</color>
	<color name="idenfyPhotoResultAppBarBackgroundColor">#0F0C11</color>
	<!-- The two consumers of idenfyBlack that are text, not a camera backdrop. -->
