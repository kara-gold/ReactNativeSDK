	<color name="idenfyDocumentPhotoResultViewRetakePhotoButtonTextColor">#F5EFE6</color>
	<color name="idenfyFacePhotoResultViewRetakePhotoButtonTextColor">#F5EFE6</color>
	<color name="idenfyUploadPhotoViewChooseAnotherPhotoButtonTextColor">#F5EFE6</color>
	<color name="idenfyIdentificationResultsViewMrzNotFoundAlertBackButtonTextColorV2">#F5EFE6</color>

	<!-- ==================== Disabled buttons ==================== -->
	<!-- No gold at all, as in the Écrin (a pale gold still reads as an action): the
