<!--
  Kara theme for the iDenfy native SDK (Android): the Écrin direction (KAR-120).

  Ported assignment by assignment from ios/IdenfyKaraTheme.swift, which stays the
  source of truth for the palette. Android has no colour API: IdenfyUISettingsV2
  only carries behaviour (onboarding view type, bottom sheets, document frame), so
  the whole theme is resource-name overrides. This module declares the sdk-api AAR
  as a dependency, so it is merged at a higher priority and a name declared here
  replaces the SDK's.

  A name the SDK does not declare is a silent no-op, so every name below was checked
  against res/values/values.xml of the extracted sdk-api 9.1.0 AAR (457 colours).

  The SDK's palette is 37 literal colours and ~420 aliases pointing at them. The
  first block repaints the roots and reaches most screens through the aliases; the
  per-screen names after it are only the places where the cascade lands wrong.

  The Écrin tokens (apps/native/lib/theme-tokens.ts), as used below:
    canvas #0F0C11 · ink #F5EFE6 · ink-2 #B9AE9F · ink-3 #85796C
    brand #E8C47F · brand-pressed #CFA75E · on-brand #241B0E
    surface ink 6 % #0FF5EFE6 · surface-hi ink 15 % #26F5EFE6
    tone-neutral ink 8 % #14F5EFE6 · surface-solid #1E1822
    positive #86C99A · negative #F0907E

  The rule the palette serves: gold marks the one action that moves the flow
  forward on each screen, and nothing else. A verification flow shows no value, so
  every accent, loader, selection, step mark and illustration is neutral. The
  previous theme did the opposite: white primary button, gold everywhere else.
-->
<resources>

	<!-- ==================== Roots ==================== -->

	<color name="idenfyBackgroundColorV2">#0F0C11</color>
	<!-- The SDK's accent: links, loaders, step marks, selections, checkboxes. Neutral
	     in one move; the one gold element per screen is the primary button, painted by
	     the gradient below. Note that idenfyStepSuccessColorV2 aliases to
	     idenfyMainDarkerColorV2 on Android, so the success colour is pinned separately
	     below. -->
	<color name="idenfyMainColorV2">#F5EFE6</color>
	<color name="idenfyMainDarkerColorV2">#F5EFE6</color>
	<color name="idenfyMainColor50percentV2">#80F5EFE6</color>

	<color name="idenfySecondColorV2">#F5EFE6</color>
	<color name="idenfySecondColor80percentV2">#CCF5EFE6</color>
	<color name="idenfySecondColor50percentV2">#80F5EFE6</color>
	<color name="idenfySecondColor20percentV2">#33F5EFE6</color>
	<color name="idenfySecondColor6percentV2">#0FF5EFE6</color>

	<!-- iOS remaps idenfyBlackV2 to the foreground because it paints content drawn
	     on light surfaces. On Android its only consumers are the splash title,
	     description and spinner, so the remap is safe and does the same job. -->
	<color name="idenfyBlackV2">#F5EFE6</color>

	<!-- idenfyBlack is deliberately NOT overridden, unlike iOS. On Android it is the
	     camera preview background (document and face capture); repainting it light
	     would put a white sheet behind the viewfinder. Its two text consumers are
	     handled by name under "App bars". -->

	<!-- idenfyWhite is deliberately NOT overridden either. 86 names alias to it, and
	     they split into two irreconcilable groups: labels on our gold buttons, which
	     must go dark, and text and icons drawn over the camera feed, which must stay
	     light. Both groups are set by name below. -->

	<!-- iOS gives idenfyLightGrayColor the translucent surface. Opaque here: on
	     Android this colour also backs the instruction card that floats over the live
	     camera, and a 6% wash there leaves the hint text sitting on the video. The
	     in-page privacy card gets the translucent value by name instead. -->
	<color name="idenfyLightGrayColor">#1E1822</color>

	<!-- No resource consumer; referenced from code only. Kept dark so it cannot
	     surface as the SDK's light grey. -->
	<color name="idenfyInactiveColorV2">#14F5EFE6</color>

	<color name="idenfyLivenessBackgroundColor">#0F0C11</color>
	<color name="idenfyPhotoResultDetailsCardBackgroundColorV2">#0FF5EFE6</color>

	<!-- Primary buttons are a gradient. These are its two ends, the Écrin filled
	     gold; the lighter middle stop lives in idenfy_ic_gradient_button_background,
	     since the SDK has no name for a third. -->
	<color name="idenfyGradientButtonColorStart">#E0BB74</color>
	<color name="idenfyGradientButtonColorEnd">#D9B264</color>

	<!-- ==================== Status tints ==================== -->
	<!-- Every "light" default is a light-mode pastel (#FFEBEE, #FFF3E0, #E8F5E9)
	     that reads as a glaring near-white block on our background. Swapped for 12%
	     washes of the Écrin semantic colours. The Écrin has no warning token: the
	     blur and glare cards keep an amber. It has no blue either: information is
	     neutral. -->

	<color name="idenfyStepSuccessColorV2">#86C99A</color>
	<color name="idenfyBorderGreenV2">#86C99A</color>
	<color name="idenfyBackgroundGreenV2">#1F86C99A</color>
	<color name="idenfyStepErrorColorV2">#F0907E</color>
	<color name="idenfyRedColorV2">#F0907E</color>
	<color name="idenfyErrorRedColorV2">#F0907E</color>
	<color name="idenfyErrorLightRedColorV2">#1FF0907E</color>
	<color name="idenfyWarningYellowV2">#E7B008</color>
	<color name="idenfyWarningLightYellowV2">#1FE7B008</color>
	<color name="idenfyBlueColor">#B9AE9F</color>
	<color name="idenfyLightBlueColor">#14F5EFE6</color>

	<!-- Face oval feedback during capture: detected goes to the Écrin green, not
	     detected to the tertiary ink. -->
	<color name="idenfyGreenColorV2">#86C99A</color>
	<color name="idenfyGrayColorV2">#85796C</color>

	<!-- iDenfy purple survives in a few highlight states: neutral, like every other
	     accent. Its only live fill consumer is the large email/SMS "verify" panel (the
	     country and document chip overrides its highlight directly), so the fill is a
