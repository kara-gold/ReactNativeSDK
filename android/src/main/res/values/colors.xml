	<color name="idenfyDocumentCameraPreviewSessionTakePhotoButtonUnFocusedBackgroundColor">#E8C47F</color>
	<color name="idenfyDocumentCameraPreviewSessionTakePhotoButtonUnFocusedTintColor">#241B0E</color>
	<color name="idenfyDocumentCameraPreviewSessionTakePhotoButtonFocusedBackgroundColor">#CFA75E</color>
	<color name="idenfyDocumentCameraPreviewSessionTakePhotoButtonFocusedTintColor">#241B0E</color>
	<color name="idenfyFaceCameraPreviewSessionTakePhotoButtonUnFocusedBackgroundColor">#E8C47F</color>
	<color name="idenfyFaceCameraPreviewSessionTakePhotoButtonUnFocusedTintColor">#241B0E</color>
	<color name="idenfyFaceCameraPreviewSessionTakePhotoButtonFocusedBackgroundColor">#CFA75E</color>
	<color name="idenfyFaceCameraPreviewSessionTakePhotoButtonFocusedTintColor">#241B0E</color>

	<!-- ==================== Secondary buttons ==================== -->
	<!-- Retake a photo, choose another file. The tonal fill comes from the
	     idenfy_ic_retake_photo_button_v2 drawable override; the label follows the
