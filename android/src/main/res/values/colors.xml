	<color name="idenfyManualReviewingStatusWaitingCommonReviewBoxFinishedBackgroundColor">#26F5EFE6</color>
	<color name="idenfyManualReviewingStatusWaitingCommonReviewBoxFinishedTitleColor">#F5EFE6</color>
	<color name="idenfyManualReviewingStatusWaitingCommonReviewBoxFinishedTickImageTintColor">#F5EFE6</color>

	<!-- ==================== Capture result, alerts and steps ==================== -->

	<!-- The frame around the captured photo followed the accent. The Écrin draws no
	     borders, and the SDK exposes no width here, so the colour goes transparent. -->
	<color name="idenfyDocumentPhotoResultViewPhotoBorderColor">#00000000</color>
	<color name="idenfyFacePhotoResultViewPhotoBorderColor">#00000000</color>

	<!-- The document name used to be picked out in gold. It stays picked out, by
	     contrast: full ink on a secondary-ink sentence. -->
	<color name="idenfyIdentificationResultsViewDocNotFoundAlertDescriptionTextColorV2">#B9AE9F</color>
	<color name="idenfyIdentificationResultsViewDocNotFoundAlertDescriptionDocumentHighlightColorV2">#F5EFE6</color>

	<!-- Processing steps: a done step reads as done (Écrin green, like the step's own
	     success mark), a step in progress stays quiet. -->
	<color name="idenfyIdentificationResultsViewDocumentStepLoadingStepDividerSuccessColor">#86C99A</color>
	<color name="idenfyIdentificationResultsViewDocumentStepLoadingStepDividerLoadingColor">#85796C</color>

	<!-- ==================== Country and document selection ==================== -->
