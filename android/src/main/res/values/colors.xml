	<color name="idenfyCountryAndDocumentSelectionViewItemSelectionBackgroundColor">#0FF5EFE6</color>
	<color name="idenfyCountryAndDocumentSelectionViewItemSelectionBorderColor">#00000000</color>
	<color name="idenfyCountryAndDocumentSelectionViewItemSelectionHighlightedBackgroundColor">#26F5EFE6</color>
	<color name="idenfyCountryAndDocumentSelectionViewItemSelectionHighlightedTextColor">#F5EFE6</color>
	<!-- The selected card draws a border with no width knob, so it is matched to the
	     fill and the shape carries the state. -->
