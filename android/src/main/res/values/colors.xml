	<color name="idenfyQuestionnaireViewContinueButtonDisabledBackgroundColor">#0FF5EFE6</color>
	<color name="idenfyQuestionnaireViewContinueButtonDisabledTextColor">#85796C</color>
	<color name="idenfyIdentificationResultsViewMismatchTagsFoundAlertContinueButtonDisabledBackgroundColorV2">#0FF5EFE6</color>
	<color name="idenfyIdentificationResultsViewMismatchTagsFoundAlertContinueButtonDisabledTextColorV2">#85796C</color>

	<!-- ==================== Cards and panels ==================== -->

	<color name="idenfyPrivacyPolicyCardViewBackgroundColor">#0FF5EFE6</color>
	<!-- The plate behind the cropping view. Defaults to the foreground colour, which
	     after the palette swap is a full-width cream block. -->
	<color name="idenfyUploadPhotoViewCroppingBackgroundColor">#0FF5EFE6</color>
	<!-- Questionnaire inputs default to a white box. No iOS counterpart: the iOS SDK
	     does not expose this one, so it is a divergence Android can fix and iOS cannot. -->
