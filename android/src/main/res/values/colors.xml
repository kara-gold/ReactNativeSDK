	<color name="idenfyCountryAndDocumentSelectionViewContinueButtonDisabledBackgroundColor">#0FF5EFE6</color>
	<color name="idenfyCountryAndDocumentSelectionViewContinueButtonDisabledTextColor">#85796C</color>
	<color name="idenfyDocumentSelectionViewContinueButtonDisabledBackgroundColor">#0FF5EFE6</color>
	<color name="idenfyDocumentSelectionViewContinueButtonDisabledTextColor">#85796C</color>
